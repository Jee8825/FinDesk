# ============================================================
# Recall — environment configuration
# Copy to .env and fill in. All vars are prefixed RECALL_.
# ============================================================

# --- Postgres (vectors + metadata) ---
RECALL_POSTGRES_DSN=postgresql+asyncpg://recall:recall@localhost:5432/recall

# --- Neo4j (provenance DAG) ---
RECALL_NEO4J_URI=bolt://localhost:7687
RECALL_NEO4J_USER=neo4j
RECALL_NEO4J_PASSWORD=recall-neo4j

# --- Redis (working memory + prefetch warm cache) ---
RECALL_REDIS_URL=redis://localhost:6379/0

# --- LLM provider selection ---
# provider: qwen | openai | anthropic | local
RECALL_LLM_PROVIDER=qwen
RECALL_EMBEDDING_PROVIDER=qwen

# Heavy model = extraction / consolidation / conflict resolution
# Light model = retrieval scoring / compression / prefetch intent
RECALL_LLM_HEAVY_MODEL=qwen-max
RECALL_LLM_LIGHT_MODEL=qwen-plus
RECALL_EMBEDDING_MODEL=text-embedding-v3
RECALL_EMBEDDING_DIM=1024

# --- Provider credentials (set the ones you use) ---
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# For local (Ollama/vLLM, OpenAI-compatible):
RECALL_LOCAL_BASE_URL=http://localhost:11434/v1

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# --- Engine tuning (sensible defaults; override to experiment) ---
# Per-tier decay rate lambda (1/day). Higher = forgets faster.
RECALL_DECAY_LAMBDA_EPISODIC=0.35
RECALL_DECAY_LAMBDA_SEMANTIC=0.02
RECALL_DECAY_LAMBDA_PROCEDURAL=0.001
# Retrieval reinforcement multiplier (r > 1)
RECALL_REINFORCEMENT_FACTOR=1.25
# Tombstone threshold tau (soft-delete below this strength)
RECALL_TOMBSTONE_THRESHOLD=0.05
# Conflict detection: cosine distance below which two facts are "about the same thing"
RECALL_CONFLICT_DISTANCE_THRESHOLD=0.25
# Confidence crystallization threshold (decay paused above this)
RECALL_CRYSTALLIZE_THRESHOLD=0.95

RECALL_LOG_LEVEL=INFO
RECALL_ENV=local
