# FinDesk dev environment — copy to .env (never commit .env)

# ---- LLM providers -------------------------------------------------------
# The agents layer (agents/findesk_agents/llm.py) tries these IN ORDER and the
# first usable answer wins. No key at all = every graph runs deterministic-only,
# which is a supported mode, not a failure. Both free tiers are day-capped, so
# the second provider exists to survive a 429 mid-demo.
GROQ_API_KEY=                 # console.groq.com — free, no card; ~1K req/day
OPENROUTER_API_KEY=           # openrouter.ai — free :free models; ~200 req/day
# Model overrides (defaults live in agents/findesk_agents/config.py):
# LLM_HEAVY_MODEL=llama-3.3-70b-versatile
# LLM_LIGHT_MODEL=llama-3.1-8b-instant
# OPENROUTER_HEAVY_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_LIGHT_MODEL=openai/gpt-oss-20b:free

# ---- memory engine (Recall) LLM ------------------------------------------
DASHSCOPE_API_KEY=            # Qwen (memory engine default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FINDESK_HEAVY_MODEL=qwen-max
FINDESK_LIGHT_MODEL=qwen-turbo

# ---- app stores ----------------------------------------------------------
APP_DATABASE_URL=postgresql+asyncpg://findesk:findesk@localhost:5433/findesk
APP_REDIS_URL=redis://localhost:6380/0

# ---- memory service (Recall) ---------------------------------------------
RECALL_BASE_URL=http://localhost:8000
# Recall's own stores are configured in memory/.env (see memory/.env.example)

# ---- auth -----------------------------------------------------------------
JWT_SECRET=change-me-in-anything-but-dev
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# ---- observability ---------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_SERVICE_NAME=findesk-dev

# ---- tool credentials (dev: sandbox/test creds only) -----------------------
SETU_AA_CLIENT_ID=
SETU_AA_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
EMAIL_PROVIDER_API_KEY=

# environment gate: non-dev refuses dev secrets (see app/config.py)
APP_ENV=dev
