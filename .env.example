# FinDesk dev environment — copy to .env (never commit .env)

# ---- LLM providers (heavy/light roles; at least one key required) -------
DASHSCOPE_API_KEY=            # Qwen (memory engine default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FINDESK_HEAVY_MODEL=qwen-max
FINDESK_LIGHT_MODEL=qwen-turbo

# ---- app stores ----------------------------------------------------------
APP_DATABASE_URL=postgresql+asyncpg://findesk:findesk@localhost:5433/findesk
APP_REDIS_URL=redis://localhost:6380/0

# ---- memory service (Recall) ---------------------------------------------
RECALL_BASE_URL=http://localhost:8000
# Recall's own stores are configured in memory/.env (see memory/.env.example)

# ---- auth -----------------------------------------------------------------
JWT_SECRET=change-me-in-anything-but-dev
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# ---- observability ---------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_SERVICE_NAME=findesk-dev

# ---- tool credentials (dev: sandbox/test creds only) -----------------------
SETU_AA_CLIENT_ID=
SETU_AA_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
EMAIL_PROVIDER_API_KEY=

# environment gate: non-dev refuses dev secrets (see app/config.py)
APP_ENV=dev
